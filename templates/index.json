        "liquid": "<style>\n.wl-util7{background:#ffffff;padding:32px 16px}\n.wl-util7-inner{max-width:760px;margin:0 auto}\n.wl-tag{font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#2d8a47;margin-bottom:8px;display:block;font-family:'Nunito',sans-serif}\n.wl-h2{font-size:clamp(22px,5vw,40px);font-weight:900 !important;line-height:1.1;margin-bottom:10px;color:#1a1a1a;font-family:'Nunito',sans-serif}\n.wl-h2 em{color:#2d8a47;font-style:normal}\n.wl-lead{font-size:15px;color:#6b7280;line-height:1.6;max-width:520px;margin-bottom:24px;font-family:'Nunito',sans-serif}\n\n/* CARROUSEL 1 étape exacte */\n.wl-u7-outer{overflow:hidden;border-radius:14px}\n.wl-u7-track{\n  display:flex;\n  overflow-x:auto;\n  scroll-snap-type:x mandatory;\n  -webkit-overflow-scrolling:touch;\n  scrollbar-width:none;\n  -ms-overflow-style:none;\n}\n.wl-u7-track::-webkit-scrollbar{display:none}\n\n.wl-u7-card{\n  flex:0 0 100%;\n  scroll-snap-align:start;\n  background:#fdf6ec;\n  border-radius:14px;\n  border:1.5px solid #e8e4dc;\n  padding:28px 22px;\n  box-sizing:border-box;\n  text-align:center;\n}\n.wl-u7-num{\n  width:40px;height:40px;border-radius:50%;\n  background:#1e5631;color:white;\n  font-size:18px;font-weight:900 !important;\n  display:flex;align-items:center;justify-content:center;\n  margin:0 auto 16px;\n  font-family:'Nunito',sans-serif;\n}\n.wl-u7-icon{font-size:44px;display:block;margin-bottom:14px;line-height:1}\n.wl-u7-title{font-size:18px;font-weight:900 !important;margin-bottom:10px;color:#1a1a1a;font-family:'Nunito',sans-serif}\n.wl-u7-desc{font-size:14px;color:#374151;line-height:1.65;font-family:'Nunito',sans-serif}\n\n/* Footer dots */\n.wl-u7-footer{display:flex;flex-direction:column;align-items:center;gap:6px;margin:12px 0 24px}\n.wl-swipe{font-size:12px;color:#9ca3af;font-family:'Nunito',sans-serif}\n.wl-u7-dots{display:flex;gap:7px}\n.wl-u7d{width:8px;height:8px;border-radius:50%;background:#e8e4dc;border:none;padding:0;cursor:pointer;transition:all .25s}\n.wl-u7d.on{background:#1e5631;width:22px;border-radius:4px}\n\n/* Bande 100 Missions */\n.wl-missions{background:#0d1f3c;border-radius:16px;padding:22px 18px}\n.wl-ms-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px}\n.wl-ms-title{font-size:17px;font-weight:900 !important;color:white;font-family:'Nunito',sans-serif;margin-bottom:3px}\n.wl-ms-sub{font-size:12px;color:rgba(255,255,255,.5);font-family:'Nunito',sans-serif}\n.wl-ms-badge{background:#f5a623;color:#1a0a00;font-size:12px;font-weight:900 !important;padding:6px 14px;border-radius:20px;white-space:nowrap;font-family:'Nunito',sans-serif;flex-shrink:0}\n.wl-ms-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}\n.wl-mc{border-radius:10px;padding:10px 8px;text-align:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09)}\n.wl-mc.e{border-color:rgba(74,222,128,.2);background:rgba(74,222,128,.04)}\n.wl-mc.s{border-color:rgba(147,197,253,.2);background:rgba(147,197,253,.04)}\n.wl-mc.lk{opacity:.3}\n.wl-mc-num{font-size:9px;font-weight:800 !important;color:rgba(255,255,255,.4);letter-spacing:.06em;margin-bottom:3px;font-family:'Nunito',sans-serif}\n.wl-mc-ic{font-size:22px;display:block;margin-bottom:4px;line-height:1}\n.wl-mc-name{font-size:11px;font-weight:700 !important;color:rgba(255,255,255,.85);line-height:1.3;font-family:'Nunito',sans-serif}\n.wl-mc-more{border-radius:10px;padding:10px 8px;text-align:center;background:rgba(245,166,35,.1);border:1.5px solid rgba(245,166,35,.25);display:flex;align-items:center;justify-content:center}\n.wl-mc-more-t{font-size:11px;font-weight:800 !important;color:#f5a623;font-family:'Nunito',sans-serif}\n\n/* Desktop — 3 colonnes */\n@media(min-width:641px){\n  .wl-util7{padding:56px 20px}\n  .wl-u7-outer{overflow:visible;border-radius:0}\n  .wl-u7-track{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    overflow:visible;\n    gap:14px;\n  }\n  .wl-u7-card{flex:none;text-align:center}\n  .wl-u7-footer{display:none}\n  .wl-ms-grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr))}\n}\n</style>\n\n<div class=\"wl-util7\">\n  <div class=\"wl-util7-inner\">\n\n    <span class=\"wl-tag\">Comment ça marche</span>\n    <h2 class=\"wl-h2\">Prêt à explorer<br><em>en moins de 5 minutes.</em></h2>\n    <p class=\"wl-lead\">Pas de montage compliqué. Pas d'application. Allumer, pointer, découvrir.</p>\n\n    <!-- Carrousel étapes -->\n    <div class=\"wl-u7-outer\">\n      <div class=\"wl-u7-track\" id=\"wlu7\">\n\n        <div class=\"wl-u7-card\">\n          <div class=\"wl-u7-num\">1</div>\n          <span class=\"wl-u7-icon\">📦</span>\n          <div class=\"wl-u7-title\">Ouvrir le coffret</div>\n          <div class=\"wl-u7-desc\">Scanner le QR code → 100 missions s'ouvrent immédiatement sur mobile ou ordinateur. Le kit est chargé, prêt à allumer.</div>\n        </div>\n\n        <div class=\"wl-u7-card\">\n          <div class=\"wl-u7-num\">2</div>\n          <span class=\"wl-u7-icon\">🔬</span>\n          <div class=\"wl-u7-title\">Choisir une mission</div>\n          <div class=\"wl-u7-desc\">Microscope ou télescope : tourner la molette pour basculer. Ajuster le zoom. L'écran affiche en temps réel ce que le kit capture.</div>\n        </div>\n\n        <div class=\"wl-u7-card\">\n          <div class=\"wl-u7-num\">3</div>\n          <span class=\"wl-u7-icon\">💬</span>\n          <div class=\"wl-u7-title\">Raconter la découverte</div>\n          <div class=\"wl-u7-desc\">Chaque mission se termine par une question à poser aux parents. L'enfant valide sa mission en la racontant. La curiosité se transmet.</div>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"wl-u7-footer\">\n      <div class=\"wl-swipe\">← Glisser →</div>\n      <div class=\"wl-u7-dots\" id=\"wlu7d\">\n        <button class=\"wl-u7d on\" onclick=\"wlu7go(0)\"></button>\n        <button class=\"wl-u7d\" onclick=\"wlu7go(1)\"></button>\n        <button class=\"wl-u7d\" onclick=\"wlu7go(2)\"></button>\n      </div>\n    </div>\n\n    <!-- Bande 100 Missions -->\n    <div class=\"wl-missions\">\n      <div class=\"wl-ms-header\">\n        <div>\n          <div class=\"wl-ms-title\">100 Missions d'exploration</div>\n          <div class=\"wl-ms-sub\">Incluses par QR code · PDF + mobile · Valeur 19,90€ · Offertes</div>\n        </div>\n        <div class=\"wl-ms-badge\">Offertes dans chaque kit</div>\n      </div>\n      <div class=\"wl-ms-grid\">\n        <div class=\"wl-mc e\"><div class=\"wl-mc-num\">Mission 01</div><span class=\"wl-mc-ic\">💇</span><div class=\"wl-mc-name\">Ton cheveu</div></div>\n        <div class=\"wl-mc e\"><div class=\"wl-mc-num\">Mission 03</div><span class=\"wl-mc-ic\">🧂</span><div class=\"wl-mc-name\">Grain de sel</div></div>\n        <div class=\"wl-mc s\"><div class=\"wl-mc-num\">Mission 51</div><span class=\"wl-mc-ic\">🌙</span><div class=\"wl-mc-name\">La lune</div></div>\n        <div class=\"wl-mc e\"><div class=\"wl-mc-num\">Mission 13</div><span class=\"wl-mc-ic\">🕸️</span><div class=\"wl-mc-name\">Toile araignée</div></div>\n        <div class=\"wl-mc s\"><div class=\"wl-mc-num\">Mission 66</div><span class=\"wl-mc-ic\">🐝</span><div class=\"wl-mc-name\">Une abeille</div></div>\n        <div class=\"wl-mc e\"><div class=\"wl-mc-num\">Mission 32</div><span class=\"wl-mc-ic\">🌱</span><div class=\"wl-mc-name\">Cellules oignon</div></div>\n        <div class=\"wl-mc s lk\"><div class=\"wl-mc-num\">Mission 81</div><span class=\"wl-mc-ic\">🌕</span><div class=\"wl-mc-name\">Terre qui tourne</div></div>\n        <div class=\"wl-mc s lk\"><div class=\"wl-mc-num\">Mission 83</div><span class=\"wl-mc-ic\">🌑</span><div class=\"wl-mc-name\">Éclipse lune</div></div>\n        <div class=\"wl-mc-more\"><div class=\"wl-mc-more-t\">+92 missions 🔍</div></div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\nfunction wlu7go(i){\n  var c=document.getElementById('wlu7');\n  if(!c)return;\n  c.scrollTo({left:i*c.offsetWidth,behavior:'smooth'});\n}\n(function(){\n  var c=document.getElementById('wlu7');\n  var dots=document.querySelectorAll('#wlu7d .wl-u7d');\n  if(!c)return;\n  c.addEventListener('scroll',function(){\n    var i=Math.round(c.scrollLeft/c.offsetWidth);\n    dots.forEach(function(d,j){d.classList.toggle('on',j===i)});\n  });\n})();\n</script>",
