        "liquid": "<style>\n.wl-intro-avis{background:#fdf6ec;padding:32px 16px 16px}\n.wl-intro-inner{max-width:760px;margin:0 auto}\n.wl-tag{font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:#2d8a47;margin-bottom:8px;display:block;font-family:'Nunito',sans-serif}\n.wl-h2{font-size:clamp(22px,5vw,40px);font-weight:900 !important;line-height:1.1;margin:0;color:#1a1a1a;font-family:'Nunito',sans-serif}\n.wl-h2 em{color:#2d8a47;font-style:normal}\n\n@media(min-width:641px){\n  .wl-intro-avis{padding:56px 20px 20px}\n}\n</style>\n\n<div class=\"wl-intro-avis\">\n  <div class=\"wl-intro-inner\">\n    <span class=\"wl-tag\">Ce qu'ils en disent</span>\n    <h2 class=\"wl-h2\">Plus de 200 familles.<br><em>Des enfants qui explorent encore.</em></h2>\n  </div>\n</div>",
