s:flex-start;gap:6px;line-height:1.5;font-family:'Nunito',sans-serif}\n.wl-av-moment::before{content:'💬';font-size:12px;flex-shrink:0;margin-top:1px}\n.wl-av-footer{display:flex;flex-direction:column;align-items:center;gap:6px;margin:10px 0 4px}\n.wl-swipe{font-size:12px;color:#9ca3af;font-family:'Nunito',sans-serif}\n.wl-av-dots{display:flex;gap:7px}\n.wl-avd{width:8px;height:8px;border-radius:50%;background:#e8e4dc;border:none;padding:0;cursor:pointer;transition:all .25s}\n.wl-avd.on{background:#e8743c;width:22px;border-radius:4px}\n@media(min-width:641px){\n  .wl-avis5{padding:56px 20px}\n  .wl-av-outer{overflow:visible;border-radius:0}\n  .wl-av-track{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible;gap:14px}\n  .wl-av-card{flex:none}\n  .wl-av-footer{display:none}\n  .wl-av-img-wrap{height:180px}\n}\n</style>\n\n<div class=\"wl-avis5\">\n  <div class=\"wl-avis5-inner\">\n    <span class=\"wl-tag-warm\">Ils l'ont offert — voilà ce qui s'est passé</span>\n    <h2 class=\"wl-h2\">Des enfants qui ont<br><em>raconté à leurs parents.</em></h2>\n    <div class=\"wl-av-outer\">\n      <div class=\"wl-av-track\" id=\"wlav\">\n\n        <div class=\"wl-av-card featured\">\n          <div class=\"wl-av-img-wrap\">\n            <img class=\"wl-av-photo\" src=\"https://cdn.shopify.com/s/files/1/0938/5417/1461/files/Design_sans_titre_61.png?v=1776347323\" alt=\"Théo explore avec Wildlab\">\n          </div>\n          <div class=\"wl-av-stars\">★★★★★</div>\n          <div class=\"wl-av-text\">\"Mon fils de 9 ans a passé tout le dimanche dehors à observer des insectes. Le soir, il a refusé d'aller se coucher parce qu'il voulait voir la lune avec le télescope. J'ai laissé. C'était le plus beau soir de l'été.\"</div>\n          <div class=\"wl-av-by\">Isabelle T.</div>\n          <div class=\"wl-av-kid\">Maman de Théo, 9 ans · Lyon</div>\n          <div class=\"wl-av-moment\">Il a dit \"j'ai photographié les cratères de la lune, maman.\"</div>\n        </div>\n\n        <div class=\"wl-av-card\">\n          <div class=\"wl-av-img-wrap\">\n            <img class=\"wl-av-photo\" src=\"https://cdn.shopify.com/s/files/1/0938/5417/1461/files/3.png?v=1776348661\" alt=\"Lucas avec le kit Wildlab\">\n          </div>\n          <div class=\"wl-av-stars\">★★★★★</div>\n          <div class=\"wl-av-text\">\"J'avais peur que ce soit fragile ou décevant. Pas du tout. En 20 minutes il avait fait 3 missions. Les 100 missions c'est vraiment ce qui fait que ça dure.\"</div>\n          <div class=\"wl-av-by\">Marie-Claire D.</div>\n          <div class=\"wl-av-kid\">Maman de Lucas, 8 ans · Nantes</div>\n          <div class=\"wl-av-moment\">Il savait quelque chose que moi je ne savais pas.</div>\n        </div>\n\n        <div class=\"wl-av-card\">\n          <div class=\"wl-av-img-wrap\">\n            <img class=\"wl-av-photo\" src=\"https://cdn.shopify.com/s/files/1/0938/5417/1461/files/2.png?v=1776348661\" alt=\"Zoé avec son Wildlab\">\n          </div>\n          <div class=\"wl-av-stars\">★★★★★</div>\n          <div class=\"wl-av-text\">\"Offert à ma petite-fille pour ses 8 ans. Elle a utilisé le télescope le soir même pour regarder la lune. Je n'ai pas pu retenir mes larmes.\"</div>\n          <div class=\"wl-av-by\">Martine G.</div>\n          <div class=\"wl-av-kid\">Grand-mère de Zoé, 8 ans · Strasbourg</div>\n          <div class=\"wl-av-moment\">Ce coup de téléphone-là, je ne l'oublierai jamais.</div>\n        </div>\n\n        <div class=\"wl-av-card\">\n          <div class=\"wl-av-img-wrap\">\n            <img class=\"wl-av-photo\" src=\"https://cdn.shopify.com/s/files/1/0938/5417/1461/files/3.png?v=1776348661\" alt=\"Emma avec le kit Wildlab\">\n          </div>\n          <div class=\"wl-av-stars\">★★★★★</div>\n          <div class=\"wl-av-text\">\"Elle est rentrée du parc en courant avec des photos d'oiseaux qu'elle avait pris au télescope. Elle m'a tout expliqué. Je ne l'avais jamais vue aussi fière d'elle.\"</div>\n          <div class=\"wl-av-by\">Sophie R.</div>\n          <div class=\"wl-av-kid\">Maman d'Emma, 7 ans · Bordeaux</div>\n          <div class=\"wl-av-moment\">Elle a posé sa tablette seul. Je n'ai rien dit.</div>\n        </div>\n\n      </div>\n    </div>\n    <div class=\"wl-av-footer\">\n      <div class=\"wl-swipe\">← Glisser →</div>\n      <div class=\"wl-av-dots\" id=\"wlavd\">\n        <button class=\"wl-avd on\" onclick=\"wlav(0)\"></button>\n        <button class=\"wl-avd\" onclick=\"wlav(1)\"></button>\n        <button class=\"wl-avd\" onclick=\"wlav(2)\"></button>\n        <button class=\"wl-avd\" onclick=\"wlav(3)\"></button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction wlav(i){\n  var c=document.getElementById('wlav');\n  if(!c)return;\n  c.scrollTo({left:i*c.offsetWidth,behavior:'smooth'});\n}\n(function(){\n  var c=document.getElementById('wlav');\n  var dots=document.querySelectorAll('#wlavd .wl-avd');\n  if(!c)return;\n  c.addEventListener('scroll',function(){\n    var i=Math.round(c.scrollLeft/c.offsetWidth);\n    dots.forEach(function(d,j){d.classList.toggle('on',j===i)});\n  });\n})();\n</script>",
