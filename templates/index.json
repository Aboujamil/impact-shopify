        "remove_horizontal_spacing": true,
        "liquid": "<style>\n.wl-psy{background:#1e5631;padding:48px 16px;position:relative;overflow:hidden}\n.wl-psy::before{content:\"\";position:absolute;top:-80px;right:-80px;width:260px;height:260px;background:radial-gradient(circle,#2d8a47 0%,transparent 70%);opacity:.4;pointer-events:none}\n.wl-psy::after{content:\"\";position:absolute;bottom:-100px;left:-100px;width:300px;height:300px;background:radial-gradient(circle,#f5a623 0%,transparent 70%);opacity:.08;pointer-events:none}\n.wl-psy-inner{max-width:760px;margin:0 auto;position:relative;z-index:1}\n\n.wl-psy-tag{font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;color:#f5a623;margin-bottom:10px;display:block;font-family:'Nunito',sans-serif}\n.wl-psy-h2{font-size:clamp(24px,5.2vw,40px);font-weight:900 !important;line-height:1.12;margin:0 0 28px;color:#ffffff;font-family:'Nunito',sans-serif;letter-spacing:-.01em}\n.wl-psy-h2 em{color:#f5a623;font-style:normal}\n\n.wl-psy-outer{overflow:hidden;border-radius:16px}\n.wl-psy-track{\n  display:flex;\n  overflow-x:auto;\n  scroll-snap-type:x mandatory;\n  -webkit-overflow-scrolling:touch;\n  scrollbar-width:none;\n  gap:12px;\n  padding-bottom:4px;\n}\n.wl-psy-track::-webkit-scrollbar{display:none}\n\n.wl-psy-card{\n  flex:0 0 100%;\n  scroll-snap-align:start;\n  background:rgba(255,255,255,.06);\n  border:1.5px solid rgba(255,255,255,.12);\n  border-radius:16px;\n  padding:24px 22px 22px;\n  box-sizing:border-box;\n  position:relative;\n}\n.wl-psy-num{\n  position:absolute;top:18px;right:22px;\n  font-size:42px;font-weight:900;color:rgba(245,166,35,.18);\n  line-height:1;font-family:'Nunito',sans-serif;letter-spacing:-.02em\n}\n.wl-psy-title{\n  font-size:18px;font-weight:900 !important;color:#f5a623;\n  margin:0 0 12px;line-height:1.25;font-family:'Nunito',sans-serif;\n  max-width:calc(100% - 50px)\n}\n.wl-psy-text{\n  font-size:14.5px;line-height:1.65;color:#ffffff;\n  margin:0 0 16px;font-family:'Nunito',sans-serif;\n  font-style:italic;opacity:.95\n}\n.wl-psy-auth{\n  font-size:12px;color:#a7d7b6;font-weight:700;\n  font-family:'Nunito',sans-serif;letter-spacing:.01em\n}\n\n/* Dots */\n.wl-psy-foot{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:18px}\n.wl-psy-swipe{font-size:11px;color:rgba(255,255,255,.5);font-family:'Nunito',sans-serif;letter-spacing:.05em}\n.wl-psy-dots{display:flex;gap:8px}\n.wl-psy-d{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.25);border:none;padding:0;cursor:pointer;transition:all .3s}\n.wl-psy-d.on{background:#f5a623;width:24px;border-radius:4px}\n\n/* Desktop — grille 2x2 */\n@media(min-width:768px){\n  .wl-psy{padding:72px 24px}\n  .wl-psy-outer{overflow:visible;border-radius:0}\n  .wl-psy-track{\n    display:grid;\n    grid-template-columns:repeat(2,1fr);\n    gap:14px;\n    overflow:visible;\n  }\n  .wl-psy-card{flex:none;padding:28px 26px 26px}\n  .wl-psy-title{font-size:19px}\n  .wl-psy-text{font-size:15px}\n  .wl-psy-foot{display:none}\n}\n</style>\n\n<div class=\"wl-psy\">\n  <div class=\"wl-psy-inner\">\n\n    <span class=\"wl-psy-tag\">Entre vous et lui</span>\n    <h2 class=\"wl-psy-h2\">Le moment que <em>vous n'oublierez pas</em> non plus.</h2>\n\n    <div class=\"wl-psy-outer\">\n      <div class=\"wl-psy-track\" id=\"wlpsy\">\n\n        <div class=\"wl-psy-card\">\n          <div class=\"wl-psy-num\">01</div>\n          <h3 class=\"wl-psy-title\">Il est rentré du jardin en courant.</h3>\n          <p class=\"wl-psy-text\">\"Il voulait absolument que je regarde l'écran. L'aile d'une libellule qu'il venait de trouver. Il était bouleversé. Moi aussi. C'était le plus beau soir de l'été.\"</p>\n          <div class=\"wl-psy-auth\">— Sophie T., maman de Léo, 8 ans</div>\n        </div>\n\n        <div class=\"wl-psy-card\">\n          <div class=\"wl-psy-num\">02</div>\n          <h3 class=\"wl-psy-title\">22h un mercredi soir.</h3>\n          <p class=\"wl-psy-text\">\"Il était censé être couché depuis une heure. Il m'a appelée doucement. Il avait trouvé un cristal de sel sous la loupe. Je ne l'ai pas grondé.\"</p>\n          <div class=\"wl-psy-auth\">— Camille R., maman de Nathan, 9 ans</div>\n        </div>\n\n        <div class=\"wl-psy-card\">\n          <div class=\"wl-psy-num\">03</div>\n          <h3 class=\"wl-psy-title\">Il savait quelque chose que je ne savais pas.</h3>\n          <p class=\"wl-psy-text\">\"Ma fille a expliqué à son grand-père pourquoi les étoiles n'ont pas toutes la même couleur. Je ne lui avais jamais rien dit là-dessus. C'est elle qui avait appris.\"</p>\n          <div class=\"wl-psy-auth\">— Patricia D., maman d'Emma, 10 ans</div>\n        </div>\n\n        <div class=\"wl-psy-card\">\n          <div class=\"wl-psy-num\">04</div>\n          <h3 class=\"wl-psy-title\">La fenêtre 6-12 ans ne se rouvre pas.</h3>\n          <p class=\"wl-psy-text\">\"Ce que vous lui montrez maintenant devient qui il sera. Pas un jouet qui finit au fond d'un tiroir — une façon de regarder le monde qui reste pour la vie.\"</p>\n          <div class=\"wl-psy-auth\">— L'équipe Wildscooper</div>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"wl-psy-foot\">\n      <div class=\"wl-psy-swipe\">← Glisser →</div>\n      <div class=\"wl-psy-dots\" id=\"wlpsyd\">\n        <button class=\"wl-psy-d on\" onclick=\"wlpsy(0)\"></button>\n        <button class=\"wl-psy-d\" onclick=\"wlpsy(1)\"></button>\n        <button class=\"wl-psy-d\" onclick=\"wlpsy(2)\"></button>\n        <button class=\"wl-psy-d\" onclick=\"wlpsy(3)\"></button>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\nfunction wlpsy(i){\n  var c=document.getElementById('wlpsy');\n  if(!c)return;\n  c.scrollTo({left:i*c.offsetWidth,behavior:'smooth'});\n}\n(function(){\n  var c=document.getElementById('wlpsy');\n  var dots=document.querySelectorAll('#wlpsyd .wl-psy-d');\n  if(!c)return;\n  c.addEventListener('scroll',function(){\n    var i=Math.round(c.scrollLeft/c.offsetWidth);\n    dots.forEach(function(d,j){d.classList.toggle('on',j===i)});\n  });\n})();\n</script>",
